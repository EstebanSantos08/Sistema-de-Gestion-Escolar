# Servidor
PORT=3001
NODE_ENV=development

# Base de datos local (SQLite) o PostgreSQL en producción
DB_PATH=./database.sqlite
DATABASE_URL=

# JWT
JWT_SECRET=CAMBIAR_POR_SECRET_SEGURO_MIN_32_CHARS
JWT_EXPIRES_IN=8h

# CORS — origen del frontend
CORS_ORIGIN=http://localhost:5173

# Institución
SCHOOL_NAME=Mi Institución Educativa
SCHOOL_ADDRESS=Dirección de la institución
SCHOOL_PHONE=+000 0 000 0000

# Escala de calificaciones
GRADE_MIN=0
GRADE_MAX=10
GRADE_PASS=7

# Período académico activo
ACTIVE_PERIOD=2026-I
