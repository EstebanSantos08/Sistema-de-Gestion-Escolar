{
  "name": "school-system-backend",
  "version": "1.0.0",
  "description": "Backend del Sistema de Gestión Escolar",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
